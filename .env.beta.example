# Closed-beta template only. Use a new Supabase project and Vercel Preview.
# Never copy production's database, Auth users, signing key, or service key here.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-beta-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-beta-publishable-key
SUPABASE_SECRET_KEY=replace-with-beta-server-secret
PASSWORD_UPDATE_CONTEXT_SECRET=replace-with-new-beta-secret-at-least-32-random-bytes
NEXT_PUBLIC_APP_URL=https://replace-with-stable-beta-preview.vercel.app
ALLOWED_EMAIL_DOMAINS=sks.org
AUTH_GOOGLE_MODE=beta
AUTH_GOOGLE_BETA_APPROVED=false
GOOGLE_AUTH_ALLOWED_DOMAINS=sks.org
AUTH_BETA_ALLOWED_EMAILS=junyuc2027@sks.org
# Keep email recovery unavailable during the Google-only pilot until SMTP is tested.
AUTH_BETA_EMAIL_ENABLED=false
NHS_SUPPORT_EMAIL=junyuc2027@sks.org
# Public project URL, used solely to refuse a beta connected to production.
AUTH_PRODUCTION_SUPABASE_URL=https://lyrjmtfrbkintzyaqygk.supabase.co
# Vercel sets VERCEL_ENV automatically. Set preview only for deployment preflight.
VERCEL_ENV=preview
NHS_DESIGN_PREVIEW=false
