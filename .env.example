# Browser-safe Supabase configuration. Use the publishable key (or the local CLI's
# legacy anon value), never the secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required for invitations, profile provisioning, and roster imports.
SUPABASE_SECRET_KEY=replace-with-secret-or-local-service-role-key

# Server-only HMAC secret for short-lived invitation/recovery password-update contexts.
# Generate at least 32 random bytes. If omitted, the secret key is used as a fallback.
PASSWORD_UPDATE_CONTEXT_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated, lowercase domains. Provisioning is still required; a matching domain grants no role.
ALLOWED_EMAIL_DOMAINS=example.edu

# Server-only mode: disabled (default), beta (isolated, allowlisted), enabled (after human beta).
# The older NEXT_PUBLIC_GOOGLE_AUTH_ENABLED flag no longer enables OAuth.
AUTH_GOOGLE_MODE=disabled
AUTH_GOOGLE_BETA_APPROVED=false
GOOGLE_AUTH_ALLOWED_DOMAINS=example.edu
# Required only in beta. Leave out of a production deployment.
# AUTH_BETA_ALLOWED_EMAILS=volunteer@example.edu
# AUTH_PRODUCTION_SUPABASE_URL=https://production-project.supabase.co
# Optional school-owned support mailbox. No contact is invented when omitted.
# NHS_SUPPORT_EMAIL=nhs-support@example.edu

# Optional additional trusted hosts for Server Actions, comma-separated without paths.
SERVER_ACTION_ALLOWED_ORIGINS=

# Server-only switch for local visual QA fixtures. Never enable in preview or production.
NHS_DESIGN_PREVIEW=false
